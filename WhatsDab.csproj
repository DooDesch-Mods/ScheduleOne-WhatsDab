<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared release hardening: strip Release debug info + assembly identity, cuts AV false positives. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props')" />

  <!--
    WhatsDab - a chat app for the in-game phone, and the first mod built on the Sideload UI framework. The whole
    interface is index.html / app.css / app.js; this project is the game-side half.

    Split in two on purpose. Chat/ is the app's own logic and references NO engine assembly at all, which is what
    lets the headless suite compile it in a second and catch an accidental dependency before a game launch. Lobby/
    is the Steam transport that carries messages between players and needs the game; the two meet at IChatSource
    and nowhere else.

    Sideload itself is never referenced - only the single-file Sideload.Api shim, which finds the host by reflection.
    It is a hard requirement to USE the app and a soft one to load it: without it the mod registers nothing and does
    nothing, rather than throwing.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>WhatsDab</RootNamespace>
    <AssemblyName>WhatsDab</AssemblyName>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <NoWarn>$(NoWarn);MSB3277;MSB3245</NoWarn>

    <WorkspaceLibPath Condition="'$(WorkspaceLibPath)' == ''">$(MSBuildThisFileDirectory)../Workspace/lib</WorkspaceLibPath>
    <ModsDirectory Condition="'$(ModsDirectory)' == ''">$(MSBuildThisFileDirectory)../_MPTest/Schedule I/Mods</ModsDirectory>
  </PropertyGroup>

  <!-- On CI the build-libs repo is checked out into ./Workspace; keep that tree out of the default compile glob.
       The explicit Sideload.Api include below comes after this and is therefore unaffected. -->
  <ItemGroup>
    <Compile Remove="Workspace/**/*.cs" />
  </ItemGroup>

  <!-- Generates DooDesch.ModVersion.Current from this project's own version property, so MelonInfo carries the
       released version and cannot drift out of it. MUST come after the Workspace Remove so CI keeps the file. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props')" />


  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(WorkspaceLibPath)/il2cpp/melonloader/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Game references, needed ONLY by Lobby/ - the Steam lobby transport that carries messages between players.

    Chat/ deliberately stays free of them, which is what lets the headless suite compile that folder without an
    engine and catch an accidental dependency in a second rather than in a game launch. The two halves meet at
    IChatSource and nowhere else.
  -->
  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(WorkspaceLibPath)/il2cpp/melonloader/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The Steamworks wrapper. Named after the upstream package, not after its namespace, which is
         Il2CppSteamworks. -->
    <Reference Include="Il2Cppcom.rlabrecque.steamworks.net">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2Cppcom.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Player derives from FishNet's NetworkBehaviour, which Contacts.cs touches when resolving a display name. -->
    <Reference Include="Il2CppFishNet.Runtime">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2CppFishNet.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The shim as SOURCE rather than as a second DLL: one file, one assembly to install, and it shows the
       drop-in-a-file path the API documents. Referencing Sideload.Api.dll instead works identically.

       Two locations for the same file. In the development monorepo the Sideload.Api project sits next to this one
       and is the single source of truth. A standalone checkout of this repo (and therefore CI) has no sibling, so
       it falls back to the copy that ships in the private build-libs repo under lib/sideload-api/. -->
  <PropertyGroup>
    <SideloadShimPath Condition="Exists('$(MSBuildThisFileDirectory)../Sideload/Sideload.Api/Sideload.cs')">$(MSBuildThisFileDirectory)../Sideload/Sideload.Api/Sideload.cs</SideloadShimPath>
    <SideloadShimPath Condition="'$(SideloadShimPath)' == '' And Exists('$(MSBuildThisFileDirectory)../Sideload.Api/Sideload.cs')">$(MSBuildThisFileDirectory)../Sideload.Api/Sideload.cs</SideloadShimPath>
    <SideloadShimPath Condition="'$(SideloadShimPath)' == '' And Exists('$(WorkspaceLibPath)/sideload-api/Sideload.cs')">$(WorkspaceLibPath)/sideload-api/Sideload.cs</SideloadShimPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Condition="'$(SideloadShimPath)' != ''" Include="$(SideloadShimPath)" Link="Sideload.Api.cs" />
  </ItemGroup>

  <!-- The web bundle. The logical names decide the prefix passed to Apps.Register.
       preview.html, s1-mock.js and the shared preview shell (sideload-preview.*, dom-surface.js) are authoring
       tools, not part of the app: they let the same files run in Chrome without a game launch, and shipping them
       inside the DLL would be dead weight the renderer would then have to skip past in the bundle. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/whatsdab/*" Exclude="Assets/whatsdab/preview.html;Assets/whatsdab/s1-mock.js;Assets/whatsdab/sideload-preview.*;Assets/whatsdab/dom-surface.js">
      <LogicalName>WhatsDab.Assets.whatsdab.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Condition="Exists('$(ModsDirectory)')" Command="cmd /c if exist &quot;$(ModsDirectory)&quot; copy /Y &quot;$(TargetPath)&quot; &quot;$(ModsDirectory)&quot;" ContinueOnError="true" />
  </Target>

</Project>
